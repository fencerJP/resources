#: data/org.gnome.Resources.desktop.in.in:9
msgid "System;Resources;Monitor;Processes;Usage;Task;Manager;CPU;RAM;Memory;GPU;Performance;Power;Battery;"
msgstr "Mfumo;Rasilimali;Kifuatiliaji;Michakato;Matumizi;Kazi;Msimamizi;CPU;RAM;Kumbukumbu;GPU;Utendaji;Nguvu;Betri;"

#: data/org.gnome.Resources.metainfo.xml.in.in:17
msgid ""
"Resources allows you to check the utilization of your system resources and "
"control your running processes and apps. It’s designed to be user-friendly "
"and feel right at home on a modern desktop by using GNOME’s libadwaita."
msgstr ""
"Rasilimali hukuruhusu kuangalia matumizi ya rasilimali za mfumo wako na "
"kudhibiti michakato na programu zinazoendesha. Imeundwa iwe rahisi kutumia "
"na kuendana na hali ya kompyuta ya kisasa kwa kutumia libadwaita ya GNOME."

#: data/org.gnome.Resources.metainfo.xml.in.in:20
msgid "Resources supports monitoring the following components:"
msgstr "Rasilimali inaweza kufuatilia vipengele vifuatavyo:"

